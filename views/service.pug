doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title #{newtitle}

        link(href="assets/img/favicon.png" rel="icon")
        link(href="assets/img/apple-touch-icon.png" rel="apple-touch-icon")

        link(href="https://fonts.googleapis.com" rel="preconnect")
        link(href="https://fonts.gstatic.com" rel="preconnect" crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Noto+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Questrial:wght@400&display=swap" rel="stylesheet")

        link(href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet")
        link(href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet")
        link(href="assets/vendor/aos/aos.css" rel="stylesheet")
        link(href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet")
        link(href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet")

        link(href="assets/css/main.css" rel="stylesheet")

        body.service-details-page
        header#header.header.d-flex.align-items-center.sticky-top
            .header-container.container-fluid.container-xl.position-relative.d-flex.align-items-center.justify-content-between
                a.logo.d-flex.align-items-center.me-auto.me-xl-0(href="index.html")
                    // Uncomment the line below if you also wish to use an image logo
                    // img(src="assets/img/logo.webp" alt="")
                    h1.sitename EasyFolio

                nav#navmenu.navmenu
                    ul
                        li: a(href="#hero") Home
                        li: a(href="#about") About
                        li: a(href="#resume") Resume
                        li: a(href="#portfolio") Portfolio
                        li: a(href="#services") Services
                        li.dropdown
                            a(href="#")
                                span Dropdown 
                                i.bi.bi-chevron-down.toggle-dropdown
                            ul
                                li: a(href="#") Dropdown 1
                                li.dropdown
                                    a(href="#")
                                        span Deep Dropdown 
                                        i.bi.bi-chevron-down.toggle-dropdown
                                    ul
                                        li: a(href="#") Deep Dropdown 1
                                        li: a(href="#") Deep Dropdown 2
                                        li: a(href="#") Deep Dropdown 3
                                        li: a(href="#") Deep Dropdown 4
                                        li: a(href="#") Deep Dropdown 5
                                li: a(href="#") Dropdown 2
                                li: a(href="#") Dropdown 3
                                li: a(href="#") Dropdown 4
                        li: a(href="#contact") Contact
                    i.mobile-nav-toggle.d-xl-none.bi.bi-list

                .header-social-links
                    a.twitter(href="#")
                        i.bi.bi-twitter-x
                    a.facebook(href="#")
                        i.bi.bi-facebook
                    a.instagram(href="#")
                        i.bi.bi-instagram
                    a.linkedin(href="#")
                        i.bi.bi-linkedin

        main.main
    // Page Title
    .page-title
        .breadcrumbs
            nav(aria-label="breadcrumb")
                ol.breadcrumb
                    li.breadcrumb-item
                        a(href="#")
                            i.bi.bi-house
                            | Home
                    li.breadcrumb-item
                        a(href="#") Category
                    li.breadcrumb-item.active.current Service Details

        .title-wrapper
            h1 Service Details
            p Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis, pulvinar dapibus leo.

    // Service Details Section
    section#service-details.service-details.section
        .container(data-aos="fade-up" data-aos-delay="100")
            .row.gy-4
                .col-lg-8
                    .service-details-slider.swiper.init-swiper
                        script(type="application/json" class="swiper-config").
                            {
                                "loop": true,
                                "speed": 600,
                                "autoplay": {
                                    "delay": 5000
                                },
                                "slidesPerView": 1,
                                "pagination": {
                                    "el": ".swiper-pagination",
                                    "type": "bullets",
                                    "clickable": true
                                }
                            }
                        .swiper-wrapper.align-items-center
                            .swiper-slide
                                img.img-fluid(loading="lazy" src="assets/img/services/services-1.webp" alt="")
                            .swiper-slide
                                img.img-fluid(loading="lazy" src="assets/img/services/services-2.webp" alt="")
                            .swiper-slide
                                img.img-fluid(loading="lazy" src="assets/img/services/services-3.webp" alt="")
                        .swiper-pagination

                    .content.mt-5
                        h3 Digital Marketing Solutions
                        p Qui laudantium consequatur laborum sit qui ad sapiente dila parde sonata raqer a videna mareta paulona marka. Aut quiatem. Ut earum tempore quidem qui recusandae distinctio quo.
                        p Et officiis id est ad voluptates sint quia architecto aut soluta eum voluptatum rerum illo mara. Ut earum tempore quidem qui recusandae distinctio quo. Veniam maiores eos cumque distinctio.

                        .features.mt-4
                            .row.gy-4
                                each code in mycode
                                    .col-md-6(data-aos="fade-up" data-aos-delay="100")
                                        .feature-box.d-flex.align-items-center
                                           i.bi.bi-check
                                           h4= code
                                each item in mylng
                                    .col-md-6(data-aos="fade-up" data-aos-delay="200")
                                        .feature-box.d-flex.align-items-center
                                           i.bi.bi-check
                                           h4= item.code
                                .col-md-6(data-aos="fade-up" data-aos-delay="300")
                                    .feature-box.d-flex.align-items-center
                                        i.bi.bi-check
                                        h4 Content Marketing Strategy
                                .col-md-6(data-aos="fade-up" data-aos-delay="400")
                                    .feature-box.d-flex.align-items-center
                                        i.bi.bi-check
                                        h4 Email Marketing Campaigns

                        p.mt-4 Ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident.

                .col-lg-4
                    .service-info
                        h4 Service Information
                        .info-item
                            i.bi.bi-clock
                            h5 Project Duration
                            p 3-6 months
                        .info-item
                            i.bi.bi-person-check
                            h5 Project Manager
                            p Sarah Johnson
                        .info-item
                            i.bi.bi-telephone
                            h5 Contact Support
                            p +1 (555) 123-4567

                    .related-services.mt-5
                        h4 Related Services
                        .service-item
                            i.bi.bi-bar-chart
                            h5
                                a(href="#") Business Analytics
                            p Aut suscipit aut cum nemo deleniti aut omnis. Doloribus ut maiores omnis facere
                        .service-item
                            i.bi.bi-briefcase
                            h5
                                a(href="#") Business Consulting
                            p Sit sint consectetur velit quisquam cupiditate impedit suscipit alias
                        .service-item
                            i.bi.bi-graph-up
                            h5
                                a(href="#") Financial Planning
                            p Sed perspiciatis omnis iste natus error sit voluptatem doloremque

                footer#footer.footer
                .container
                    .copyright.text-center
                    p © 
                        span Copyright 
                        strong.px-1.sitename EasyFolio 
                        span All Rights Reserved

                    .social-links.d-flex.justify-content-center
                    a(href="") i.bi.bi-twitter-x
                    a(href="") i.bi.bi-facebook
                    a(href="") i.bi.bi-instagram
                    a(href="") i.bi.bi-linkedin

                    .credits
                    | Designed by 
                    a(href="https://bootstrapmade.com/") BootstrapMade

                // Scroll Top
                a#scroll-top.scroll-top.d-flex.align-items-center.justify-content-center(href="#")
                i.bi.bi-arrow-up-short


                script(src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js")
                script(src="assets/vendor/php-email-form/validate.js")
                script(src="assets/vendor/aos/aos.js")
                script(src="assets/vendor/waypoints/noframework.waypoints.js")
                script(src="assets/vendor/glightbox/js/glightbox.min.js")
                script(src="assets/vendor/imagesloaded/imagesloaded.pkgd.min.js")
                script(src="assets/vendor/isotope-layout/isotope.pkgd.min.js")
                script(src="assets/vendor/swiper/swiper-bundle.min.js")

                script(src="assets/js/main.js")
